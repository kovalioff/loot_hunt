BOT_TOKEN=
BOT_USERNAME=loot_hunt_bot
GEMINI_API_KEY=
DATABASE_PATH=data/loot_hunt.db
WATCHER_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO
ADMIN_IDS=
APP_TIMEZONE=Europe/Warsaw
PEPPER_TIMEOUT_SECONDS=25
PEPPER_MAX_CONCURRENCY=4
SEARCH_RESULT_CAP=25
SEARCH_SESSION_TTL_SECONDS=3600

# Affiliate Monetization (Партнерские ссылки для заработка)
# Amazon Associates Tracking IDs (например: loothunt-de-21)
AMAZON_TAG_PL=
AMAZON_TAG_DE=
AMAZON_TAG_UK=

# Allegro Partner Network / Convertiser prefix redirect
# Например: https://track.convertiser.com/click?publisher_id=XXXXX&url=
ALLEGRO_AFFILIATE_PREFIX=

# Awin Affiliate tracking template ({url} подставляется автоматически)
# Например: https://www.awin1.com/cread.php?awinaffid=XXXXX&ued={url}
AWIN_AFFILIATE_TEMPLATE=

# Telegram Channel Auto-Publisher (опционально)
DEALS_CHANNEL_ID=
MIN_CHANNEL_TEMPERATURE=300
